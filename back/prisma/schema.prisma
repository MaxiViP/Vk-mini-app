generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum UserStatus {
  active
  blocked
  deleted
}

enum AuthProvider {
  vk
  google
  yandex
  phone
}

enum LedgerType {
  credit
  debit
  hold
  release
  refund
}

enum LedgerReason {
  payment_topup
  usage_charge
  admin_adjust
  subscription_purchase
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  expired
}

enum PaymentProvider {
  yookassa
}

enum PaymentStatus {
  pending
  succeeded
  failed
  canceled
}

enum DiscountType {
  percent
  fixed_minor
  topup_bonus_percent
  topup_bonus_fixed_minor
}

enum DiscountApplicationType {
  subscription_purchase
  wallet_topup
}

enum ModelTier {
  basic
  premium
}

enum UsageBillingSource {
  payg
  subscription_included
}

enum UsageStatus {
  pending
  completed
  reversed
}

// MODELS
model User {
  id         String     @id @default(uuid())
  email      String?    @unique
  phoneE164  String?    @unique @map("phone_e164")
  firstName  String?    @map("first_name")
  lastName   String?    @map("last_name")
  avatarUrl  String?    @map("avatar_url")
  status     UserStatus @default(active)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  authIdentities AuthIdentity[]
  sessions       Session[]
  wallet         Wallet?
  walletLedger   WalletLedger[]
  subscriptions  Subscription[]
  payments       Payment[]
  targetedDiscounts Discount[]           @relation("DiscountTargetUser")
  discountRedemptions DiscountRedemption[]
  usageEvents    UsageEvent[]
  auditActions   AuditLog[]      @relation("ActorUserAuditLog")
  workspace      UserWorkspace?

  @@map("users")
}

model UserWorkspace {
  userId       String   @id @map("user_id")
  chatHistory  Json?    @map("chat_history_json")
  notesPayload Json?    @map("notes_payload_json")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_workspaces")
}

model AuthIdentity {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  provider        AuthProvider
  providerUserId  String       @map("provider_user_id")
  providerPayload Json?        @map("provider_payload_json")
  createdAt       DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpCode {
  id         String    @id @default(uuid())
  phoneE164  String    @map("phone_e164")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phoneE164, expiresAt])
  @@map("otp_codes")
}

model Wallet {
  userId       String   @id @map("user_id")
  balanceMinor Int      @default(0) @map("balance_minor")
  currency     String   @default("RUB")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletLedger {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  type           LedgerType
  amountMinor    Int          @map("amount_minor")
  reason         LedgerReason
  referenceType  String?      @map("reference_type")
  referenceId    String?      @map("reference_id")
  idempotencyKey String       @unique @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_ledger")
}

model Plan {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String
  productType      String?   @map("product_type")
  priceMinor       Int       @map("price_minor")
  intervalDays     Int       @map("interval_days")
  includedRequests Int       @map("included_requests")
  accessTier       ModelTier @default(basic) @map("access_tier")
  aiChatLimit      Int?      @map("ai_chat_limit")
  aiVoiceLimit     Int?      @map("ai_voice_limit")
  aiFileUploadLimit Int?     @map("ai_file_upload_limit")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  planId            String             @map("plan_id")
  status            SubscriptionStatus @default(active)
  periodStart       DateTime           @map("period_start")
  periodEnd         DateTime           @map("period_end")
  includedRequests  Int                @map("included_requests")
  usedRequests      Int                @default(0) @map("used_requests")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  endedAt           DateTime?          @map("ended_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  usageEvents UsageEvent[]
  discountRedemptions DiscountRedemption[]

  @@index([userId, status])
  @@index([planId])
  @@map("subscriptions")
}

model Payment {
  id                String          @id @default(uuid())
  userId            String          @map("user_id")
  provider          PaymentProvider
  providerPaymentId String          @unique @map("provider_payment_id")
  amountMinor       Int             @map("amount_minor")
  creditedAmountMinor Int?          @map("credited_amount_minor")
  bonusAmountMinor  Int?            @map("bonus_amount_minor")
  promoCodeSnapshot String?         @map("promo_code_snapshot")
  appliedDiscountId String?         @map("applied_discount_id")
  appliedDiscountSnapshot Json?     @map("applied_discount_snapshot_json")
  status            PaymentStatus   @default(pending)
  idempotencyKey    String          @unique @map("idempotency_key")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events PaymentEvent[]
  appliedDiscount Discount?        @relation(fields: [appliedDiscountId], references: [id], onDelete: SetNull)
  discountRedemptions DiscountRedemption[]

  @@index([userId, createdAt])
  @@index([appliedDiscountId])
  @@map("payments")
}

model PaymentEvent {
  id         String   @id @default(uuid())
  paymentId  String   @map("payment_id")
  eventType  String   @map("event_type")
  rawPayload Json     @map("raw_payload_json")
  receivedAt DateTime @default(now()) @map("received_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, receivedAt])
  @@map("payment_events")
}

model UsageEvent {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  modelProvider  String             @map("model_provider")
  modelName      String             @map("model_name")
  billingTier    ModelTier          @map("billing_tier")
  billingSource  UsageBillingSource @default(payg) @map("billing_source")
  status         UsageStatus        @default(completed)
  subscriptionId String?            @map("subscription_id")
  inputTokens    Int                @default(0) @map("input_tokens")
  outputTokens   Int                @default(0) @map("output_tokens")
  costMinor      Int                @default(0) @map("cost_minor")
  requestId      String             @unique @map("request_id")
  createdAt      DateTime           @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("usage_events")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser User? @relation("ActorUserAuditLog", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

model Discount {
  id           String       @id @default(uuid())
  code         String?      @unique
  name         String
  description  String?
  discountType DiscountType @map("discount_type")
  value        Int
  productType  String?      @map("product_type")
  planCode     String?      @map("plan_code")
  isActive     Boolean      @default(true) @map("is_active")
  isAutomatic  Boolean      @default(false) @map("is_automatic")
  startsAt     DateTime?    @map("starts_at")
  endsAt       DateTime?    @map("ends_at")
  maxUses      Int?         @map("max_uses")
  maxUsesPerUser Int?       @map("max_uses_per_user")
  firstPurchaseOnly Boolean @default(false) @map("first_purchase_only")
  allowStacking Boolean     @default(false) @map("allow_stacking")
  targetUserId String?      @map("target_user_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  targetUser   User?                @relation("DiscountTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  payments     Payment[]
  redemptions  DiscountRedemption[]

  @@index([isActive, isAutomatic, startsAt, endsAt])
  @@index([productType, planCode])
  @@index([targetUserId])
  @@map("discounts")
}

model DiscountRedemption {
  id                 String                  @id @default(uuid())
  discountId         String                  @map("discount_id")
  userId             String                  @map("user_id")
  paymentId          String?                 @map("payment_id")
  subscriptionId     String?                 @map("subscription_id")
  promoCodeSnapshot  String?                 @map("promo_code_snapshot")
  baseAmountMinor    Int                     @map("base_amount_minor")
  discountAmountMinor Int                    @map("discount_amount_minor")
  finalAmountMinor   Int                     @map("final_amount_minor")
  applicationType    DiscountApplicationType @map("application_type")
  createdAt          DateTime                @default(now()) @map("created_at")

  discount      Discount      @relation(fields: [discountId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([discountId, createdAt])
  @@index([userId, createdAt])
  @@index([paymentId])
  @@index([subscriptionId])
  @@map("discount_redemptions")
}
